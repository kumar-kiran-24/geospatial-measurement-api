# ---------------------------------------------------------------------------
# Geospatial File Measurement API - example environment file.
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# All values below are safe, non-production placeholders.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=Geospatial File Measurement API
# One of: development | test | production
APP_ENV=development
DEBUG=false
# Prefix in front of every business (non-health) route.
API_PREFIX=/api
# Comma-separated list of allowed CORS origins (used in Phase B by the SPA).
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL. The driver must be psycopg (v3), e.g.:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://geo_app:geo_app@localhost:5432/geospatial_files
# Test database used by pytest (separate DB so tests never touch dev data).
TEST_DATABASE_URL=postgresql+psycopg://geo_app:geo_app@localhost:5432/geospatial_files_test
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Upload storage ----------------------------------------------------------
# Directory that holds uploaded source files. Created on startup if missing.
STORAGE_ROOT=./var/storage
# Hard limit for a single upload request, in bytes (default 25 MiB).
MAX_UPLOAD_SIZE_BYTES=26214400
# Allowed upload extensions (comma separated).
ALLOWED_EXTENSIONS=.kml,.zip
# Safety limits applied when inspecting ZIP archives.
MAX_ZIP_ENTRIES=64
MAX_ZIP_UNCOMPRESSED_BYTES=209715200
MAX_ZIP_COMPRESSION_RATIO=100
# Guard rail: refuse files with more features than this (protects the API).
MAX_FEATURES_PER_FILE=100000
# Guard rail: refuse individual .dbf/.shp members above this size.
MAX_ARCHIVE_MEMBER_BYTES=104857600

# --- Processing --------------------------------------------------------------
# Processing is synchronous in this version (see README). When true, a failure
# during processing marks the record FAILED and still returns 201.
SYNC_PROCESSING=true

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# One of: json | console
LOG_FORMAT=json
